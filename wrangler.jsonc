{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codeyau",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".wrangler/**",
      "node_modules/**"
    ]
  },
  "observability": {
    "enabled": true
  }
}
